{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "biome-synth.vercel.app" }],
      "destination": "https://synth.bar-builds.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "biome-synth.vercel.app" }],
      "destination": "https://synth.bar-builds.com/:path*",
      "permanent": true
    }
  ]
}
